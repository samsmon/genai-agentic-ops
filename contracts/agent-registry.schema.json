{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.genai-agentic-ops.org/agent-registry.schema.json",
  "title": "AgentRegistry",
  "description": "Agent and runtime registration contract for genai-agentic-ops",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agents"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime",
            "command",
            "enabled",
            "roles",
            "maturity"
          ],
          "properties": {
            "runtime": {
              "type": "string",
              "enum": [
                "antigravity",
                "claude-code",
                "codex",
                "gemini-cli",
                "custom"
              ]
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "binary_path": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "roles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "planner",
                  "developer",
                  "tester",
                  "reviewer"
                ]
              }
            },
            "maturity": {
              "type": "string",
              "enum": [
                "documented",
                "fixture-tested",
                "live-tested"
              ]
            },
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "streaming": {
                  "type": "boolean"
                },
                "resume": {
                  "type": "string",
                  "enum": [
                    "verified",
                    "unverified",
                    "unsupported"
                  ]
                },
                "interrupt": {
                  "type": "string",
                  "enum": [
                    "process_group",
                    "session",
                    "unsupported"
                  ]
                },
                "permission_modes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "output_format": {
                  "type": "string",
                  "enum": [
                    "json",
                    "stream-json",
                    "text"
                  ]
                }
              }
            },
            "env_overrides": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}

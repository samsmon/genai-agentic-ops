{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.genai-agentic-ops.org/plan.schema.json",
  "title": "WorkflowPlan",
  "description": "Structured execution plan submitted by host or external planner",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "title",
    "planner",
    "execution_mode",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^wf-[a-zA-Z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "planner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runtime",
        "attested"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "enum": [
            "host",
            "antigravity",
            "claude-code",
            "codex",
            "gemini-cli",
            "custom"
          ]
        },
        "attested": {
          "type": "boolean"
        }
      }
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "sequential",
        "parallel"
      ]
    },
    "approval_required": {
      "type": "boolean"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "title",
          "role",
          "runtime",
          "acceptance_criteria"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^task-[a-zA-Z0-9_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "planner",
              "developer",
              "tester",
              "reviewer"
            ]
          },
          "runtime": {
            "type": "string",
            "enum": [
              "auto",
              "host",
              "antigravity",
              "claude-code",
              "codex",
              "gemini-cli",
              "custom"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^task-[a-zA-Z0-9_-]+$"
            }
          },
          "allowed_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "protected_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification_commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retry_limit": {
            "type": "integer",
            "minimum": 0
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 10
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.genai-agentic-ops.org/config.schema.json",
  "title": "ProjectConfiguration",
  "description": "Project-scoped configuration contract for genai-agentic-ops",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "orchestration",
    "governance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planner",
        "execution",
        "approval"
      ],
      "properties": {
        "planner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "default", "allow_override"],
          "properties": {
            "strategy": {
              "type": "string",
              "enum": ["dynamic", "host_only", "external_only"]
            },
            "default": {
              "type": "string",
              "minLength": 1
            },
            "allow_override": {
              "type": "boolean"
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "parallel", "max_workers", "timeout_seconds"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["shared", "worktree"]
            },
            "parallel": {
              "type": "boolean"
            },
            "max_workers": {
              "type": "integer",
              "minimum": 1
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 10
            }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_attempts", "fallback"],
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 0
            },
            "fallback": {
              "type": "string",
              "enum": ["none", "user_prompt"]
            }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan", "destructive_actions"],
          "properties": {
            "plan": {
              "type": "string",
              "enum": ["required", "optional"]
            },
            "destructive_actions": {
              "type": "string",
              "enum": ["required"]
            },
            "task_completion": {
              "type": "string",
              "enum": ["required", "optional"]
            },
            "merge": {
              "type": "string",
              "enum": ["required", "optional"]
            }
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_policy",
        "protect_user_changes",
        "enforce_file_ownership",
        "require_verification"
      ],
      "properties": {
        "git_policy": {
          "type": "string",
          "enum": ["agent-commits", "user-only-git"]
        },
        "protect_user_changes": {
          "type": "boolean"
        },
        "enforce_file_ownership": {
          "type": "boolean"
        },
        "require_verification": {
          "type": "boolean"
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_verification_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anti_monolith_limit": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "path"],
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["filesystem", "sqlite"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

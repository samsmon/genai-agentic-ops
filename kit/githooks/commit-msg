#!/bin/sh
# commit-msg hook, two checks:
#   1. reject agent attribution lines in the message and agent/bot commit identities
#   2. reject messages that do not follow Conventional Commits (scripts/agentic-ops/commit-msg-check.sh)
# Exceptions, only on the user's say-so:  ALLOW_AGENT_TRAILER=1 skips check 1,  SKIP_COMMIT_FORMAT=1 skips check 2.
msg="$1"
if [ "$ALLOW_AGENT_TRAILER" != "1" ]; then
  if grep -Eiq '^(co-authored-by|signed-off-by|generated-by):|generated with|🤖' "$msg"; then
    echo "COMMIT REJECTED: message carries an agent attribution line (Co-Authored-By, Signed-off-by, Generated with)." >&2
    echo "Remove that line and commit again." >&2
    exit 1
  fi
  ident="$(git var GIT_AUTHOR_IDENT 2>/dev/null) $(git var GIT_COMMITTER_IDENT 2>/dev/null)"
  if printf '%s' "$ident" | grep -Eiq 'anthropic|claude|gemini|antigravity|codex|openai|\[bot\]'; then
    echo "COMMIT REJECTED: author/committer identity looks like an agent or bot: $ident" >&2
    echo "The commit identity must be the user's (git config user.name / user.email on this device)." >&2
    exit 1
  fi
fi
dir="${AGENTIC_OPS_DIR:-scripts/agentic-ops}"
if [ -f "$dir/commit-msg-check.sh" ]; then
  sh "$dir/commit-msg-check.sh" "$msg" || exit 1
else
  echo "warning: $dir/commit-msg-check.sh not found; the commit message format was not checked" >&2
fi
exit 0
